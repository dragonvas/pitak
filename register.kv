<RegisterScreen>:
    name: "Register"

    BoxLayout:
        orientation: "vertical"
        padding: 100
        spacing: 15
        Label:
            id: koka
            text: "Зарегистрируйтесь"
            font_size: 50

        Label:
            text: "Логин"

        TextInput:
            id: login
            multiline: False

        Label:
            text: "Пароль"

        TextInput:
            id: password
            multiline: False

        Label:
            text: "Повторите пароль"

        TextInput:
            id: password_again
            multiline: False

        Button:
            text: "Зарегистрироваться"
            on_press: root.reg_button()

        Button:
            text: "Вернутся к авторизации"
            on_press: root.AutorizationBack_button()
